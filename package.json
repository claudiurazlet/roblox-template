{
  "name": "roblox-template",
  "version": "1.0.0",
  "description": "Generated by [Rojo](https://github.com/rojo-rbx/rojo) 7.5.1.",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:headless",
    "test:headless": "node -e \"require('fs').mkdirSync('out', { recursive: true })\" && rojo build default.project.json -o out/test-place.rbxlx && run-in-roblox --place out/test-place.rbxlx --script scripts/run-tests.server.luau",
    "init:project": "node tools/initProject.js",
    "build:rojo": "node tools/genRojoTree.js",
    "build:luau:sourcemap": "rojo sourcemap default.project.json --output sourcemap.json --include-non-scripts",
    "check:luau:analyze": "node tools/runLuauAnalyze.js",
    "check:luau": "npm run build:rojo && npm run build:luau:sourcemap && npm run check:luau:analyze",
    "export:luau:diagnostics": "node tools/exportLuauDiagnostics.js",
    "export:luau:diagnostics:all": "node tools/exportLuauDiagnostics.js --scope all",
    "watch:rojo": "chokidar \"src/**/*\" -c \"npm run build:rojo\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudiurazlet/roblox-template.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/claudiurazlet/roblox-template/issues"
  },
  "homepage": "https://github.com/claudiurazlet/roblox-template#readme",
  "devDependencies": {
    "chokidar-cli": "^3.0.0"
  }
}
